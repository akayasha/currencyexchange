              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/history/pair/latest?from={{fromCurrencyCode}}&to={{toCurrencyCode}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "history", "pair", "latest"],
              "query": [
                {
                  "key": "from",
                  "value": "{{fromCurrencyCode}}"
                },
                {
                  "key": "to",
                  "value": "{{toCurrencyCode}}"
                }
              ]
            },
            "description": "Retrieve the most recent rate change for a specific currency pair"
          },
          "response": []
        },
        {
          "name": "6. Get History Statistics for Currency Pair",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/history/pair/stats?from={{fromCurrencyCode}}&to={{toCurrencyCode}}",
